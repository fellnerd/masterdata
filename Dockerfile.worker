# Worker Dockerfile
# Separate container for BullMQ job processing with dbt
# =====================================================
# Runs structured dbt commands (schema-deploy, data-deploy, Data Vault
# import) against masterdata's own embedded dbt project only - never
# against externally connected dbt projects (those are read-only).
# =====================================================

# Pinned to alpine3.21 (Python 3.12) rather than the floating "node:22-alpine"
# tag: newer Alpine releases ship Python 3.14, whose C-API break makes
# pyodbc (a dbt-sqlserver dependency) fail to compile.
FROM node:22-alpine3.21

WORKDIR /app

# =====================================================
# Install dbt dependencies
# =====================================================
RUN apk add --no-cache \
    python3 \
    py3-pip \
    git \
    unixodbc \
    unixodbc-dev \
    freetds-dev \
    build-base \
    python3-dev \
    bash

# Install Microsoft ODBC Driver 18. Architecture is detected at build time
# since Microsoft ships separate amd64/arm64 .apk files (the same x86-64
# binary silently fails to dlopen on an arm64 host).
RUN apk add --no-cache curl gnupg && \
    case "$(uname -m)" in \
      x86_64) MSODBC_ARCH=amd64 ;; \
      aarch64) MSODBC_ARCH=arm64 ;; \
      *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac && \
    curl -O https://download.microsoft.com/download/0b3d5518-b4a7-4a2b-afc7-7ee9e967f93c/msodbcsql18_18.6.2.1-1_${MSODBC_ARCH}.apk && \
    apk add --allow-untrusted msodbcsql18_18.6.2.1-1_${MSODBC_ARCH}.apk && \
    rm msodbcsql18_18.6.2.1-1_${MSODBC_ARCH}.apk

# Install dbt-core and dbt-sqlserver
RUN pip3 install --break-system-packages \
    dbt-core==1.9.0 \
    dbt-sqlserver==1.9.0

# Install dependencies
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Copy dbt project
COPY ./dbt ./dbt

# Install tsx for running TypeScript directly
RUN npm install -g tsx

# Environment variables
ENV NODE_ENV=production
ENV WORKER_CONCURRENCY=2

# dbt environment variables - set at runtime via docker-compose/.env, not baked
# into the image (MDS_DB_SERVER/DATABASE/USER/PASSWORD)
ENV DBT_PROFILES_DIR=/app/dbt

# Run the worker
CMD ["tsx", "src/lib/queue/worker.ts"]
