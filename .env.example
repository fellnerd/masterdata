# Master Data Services - Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# REQUIRED: Authentication
# ============================================

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# ============================================
# OPTIONAL: Microsoft Entra ID (Azure AD)
# ============================================
# Required for "Sign in with Microsoft" functionality
# Get these values from Azure Portal > App Registrations

# AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
# AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# ============================================
# Database Configuration
# ============================================

# Azure SQL Server hostname
DB_SERVER=sql-datavault-weu-001.database.windows.net

# Database name
DB_NAME=Vault

# Mock mode (true for development without database)
DB_MOCK=false

# SQL Authentication (leave empty for Azure AD / Managed Identity)
# DB_USER=
# DB_PASSWORD=

# ============================================
# Redis / Job Queue
# ============================================

# Redis connection (defaults work with docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# Mock mode (true for development without Redis)
QUEUE_MOCK=false

# Worker concurrency (number of parallel jobs)
WORKER_CONCURRENCY=2

# ============================================
# Development Settings
# ============================================

# Enable dev login form (DISABLE IN PRODUCTION!)
NEXT_PUBLIC_DEV_MODE=false
