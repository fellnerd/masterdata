# Master Data Services - Environment Configuration
# Copy this file to .env and fill in the values before running docker-compose

# ============================================
# REQUIRED: Authentication
# ============================================

# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Public URL the app is served under (used for OAuth callbacks and canonical links)
AUTH_URL=https://mds.example.com

# ============================================
# OPTIONAL: Microsoft Entra ID (Azure AD)
# ============================================
# Required for "Sign in with Microsoft" functionality
# Get these values from Azure Portal > App Registrations

# AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
# AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# ============================================
# REQUIRED: Database Configuration
# ============================================
# Azure SQL Server used both by the Next.js API (DB_*) and by the embedded
# dbt project's "prod" target (MDS_DB_* - injected automatically from these
# same values by docker-compose, no need to duplicate them).

DB_SERVER=your-server.database.windows.net
DB_NAME=your-database
DB_USER=your-sql-user
DB_PASSWORD=your-sql-password

# Mock mode (true for development without database)
DB_MOCK=false

# ============================================
# REQUIRED: Internal worker <-> app secret
# ============================================
# Shared secret used by mds-worker to call back into mds-app's internal
# deploy-status endpoints. Must be identical in both containers.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ============================================
# REQUIRED: Redis / Job Queue
# ============================================
# docker-compose.yml uses Upstash (cloud Redis) exclusively.
UPSTASH_REDIS_URL=rediss://default:password@host:port

# Mock mode (true for development without Redis)
QUEUE_MOCK=false

# Worker concurrency (number of parallel jobs)
WORKER_CONCURRENCY=2

# ============================================
# OPTIONAL: dbt target
# ============================================
# Which profiles.yml target both containers' dbt commands run against.
# Defaults to "prod" (SQL auth via MDS_DB_* above) if unset.
DBT_TARGET=prod

# ============================================
# Development Settings
# ============================================

# Enable dev login form (DISABLE IN PRODUCTION!)
NEXT_PUBLIC_DEV_MODE=false
