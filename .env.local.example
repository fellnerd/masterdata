# Authentication (Microsoft Entra ID)
AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# NextAuth
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Database (Azure SQL)
DATABASE_SERVER=sql-datavault-weu-001.database.windows.net
DATABASE_NAME=MDS
DATABASE_USER=sqladmin
DATABASE_PASSWORD=your-password
# Alternative: Use Azure AD Auth (recommended)
DATABASE_USE_AZURE_AD=true
AZURE_CLIENT_ID=your-managed-identity-client-id

# Redis (BullMQ Job Queue)
REDIS_URL=redis://localhost:6379
# Alternative: Upstash (Serverless)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Logging
LOG_LEVEL=info
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx

# Feature Flags
FEATURE_DBT_INTEGRATION=true
FEATURE_APPROVAL_WORKFLOW=true
